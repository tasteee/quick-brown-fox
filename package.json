{
  "name": "quick-brown-fox",
  "version": "0.3.1",
  "description": "Zero-config bundler for desktop apps. Write a normal web UI plus an optional Node server, run it as an Electron desktop app - no Electron wiring required.",
  "keywords": [
    "electron",
    "vite",
    "react",
    "solid",
    "vue",
    "svelte",
    "typescript",
    "desktop",
    "bundler",
    "zero-config"
  ],
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "qbf": "bin/qbf.js",
    "quick-brown-fox": "bin/qbf.js"
  },
  "exports": {
    "./client": {
      "types": "./runtime/client.d.ts",
      "default": "./runtime/client.mjs"
    },
    "./server": {
      "types": "./runtime/server.d.ts",
      "default": "./runtime/server.mjs"
    },
    "./render": {
      "types": "./runtime/render.d.ts",
      "default": "./runtime/render.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "runtime",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node test/cli.test.js",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.4",
    "vite": "^8.1.4",
    "vite-plugin-solid": "^2.11.12",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
