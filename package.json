{
  "name": "quick-brown-fox",
  "version": "0.2.0",
  "description": "Zero-config bundler for desktop apps. Write a normal React + TypeScript UI plus an optional Node server, run it as an Electron desktop app — no Electron wiring required.",
  "keywords": [
    "electron",
    "vite",
    "react",
    "typescript",
    "desktop",
    "bundler",
    "zero-config"
  ],
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "qbf": "bin/qbf.js",
    "quick-brown-fox": "bin/qbf.js"
  },
  "exports": {
    "./client": {
      "types": "./runtime/client.d.ts",
      "default": "./runtime/client.mjs"
    },
    "./server": {
      "types": "./runtime/server.d.ts",
      "default": "./runtime/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "runtime",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/cli.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
